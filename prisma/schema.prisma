// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model NutritionInfo {
  id              String  @id @default(uuid()) @db.Uuid

  name            String

  // Makronutrien utama (dari kartu angka besar)
  calories        Float          // 250 kkal
  protein         Float          // 20 g
  fat             Float          // 15 g
  carbohydrate    Float          // 8 g

  // Mikronutrien (dari baris bawah)
  saturatedFat    Float?  @map("saturated_fat")      // 4.5 g (Lemak Jenuh)
  fiber           Float?  @map("fiber")              // 0.5 g (Serat)
  sugar           Float?  @map("sugar")              // 2.0 g (Gula)
  sodium          Float?  @map("sodium")             // 480 mg (Natrium) — dalam mg

  // Satuan
  caloriesUnit    String  @default("kkal") @map("calories_unit")
  weightUnit      String  @default("g") @map("weight_unit")
  sodiumUnit      String  @default("mg") @map("sodium_unit")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@map("nutrition_info")
}